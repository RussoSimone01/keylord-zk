{
	"Logging": {
		"LogLevel": {
			"Default": "Information",
			"Microsoft.AspNetCore": "Warning"
		}
	},
	"AllowedHosts": "*",
	"ConnectionStrings": {
		"Default": ""
	},
	"Jwt": {
		"Secret": "",
		"Issuer": "keylord-zk",
		"Audience": "keylord-zk-client",
		"AccessTokenExpiryMinutes": 15,
		"RefreshTokenExpiryDays": 7
	},
	"Cors": {
		"AllowedOrigin": ""
	},
	"ReverseProxy": {
		"Enabled": false,
		"ClientIpHeader": "X-Forwarded-For",
		"ForwardLimit": 1
	},
	"IpRateLimiting": {
		"EnableEndpointRateLimiting": true,
		"EndpointWhitelist": ["get:/health"],
		"StackBlockedRequests": false,
		"HttpStatusCode": 429,
		"QuotaExceededResponse": {
			"StatusCode": 429,
			"ContentType": "application/problem+json",
			"Content": "{{\"type\":\"https://tools.ietf.org/html/rfc6585#section-4\",\"title\":\"Too Many Requests\",\"status\":429,\"detail\":\"Too many requests: maximum {0} per {1}, try again in {2} second(s)\",\"code\":\"rate_limit.exceeded\"}}"
		},
		"GeneralRules": [
			{
				"Endpoint": "POST:/api/auth/register",
				"Period": "1m",
				"Limit": 5
			},
			{
				"Endpoint": "POST:/api/auth/login",
				"Period": "1m",
				"Limit": 10
			},
			{
				"Endpoint": "GET:/api/auth/salt/*",
				"Period": "1m",
				"Limit": 10
			}
		]
	}
}
